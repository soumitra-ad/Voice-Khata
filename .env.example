# Server-side only. Never copy into public/ or any client file.
# TODO: VERIFY FROM GNANI DOCS — every GNANI_* value below is unknown until checked against the docs.
# Run `npm run probe -- ./sample.wav` to see Prisma's raw events, then fill in the event/field names.
GNANI_API_KEY=
GNANI_AUTH_HEADER=                # header NAME that carries the key
GNANI_AUTH_VALUE={key}            # header value template; {key} = GNANI_API_KEY
GNANI_LANG_MAP=                   # e.g. hi:<code>,mr:<code>,bn:<code>,en:<code>

# Prisma v3.0 STT (WebSocket streaming)
GNANI_STT_WS_URL=
GNANI_STT_START_MESSAGE=          # text/JSON sent when an utterance starts; {lang} placeholder
GNANI_STT_END_MESSAGE=            # text/JSON sent on push-to-talk release
GNANI_STT_EVENT_FIELD=type        # dotted path to the event-kind field in server messages
GNANI_STT_PARTIAL_EVENT=          # value of that field for partial results
GNANI_STT_FINAL_EVENT=            # value of that field for final results
GNANI_STT_TEXT_FIELD=text         # dotted path to the transcript text

# Timbre v3.0 TTS (WebSocket streaming). Stock voices only.
GNANI_TTS_WS_URL=
GNANI_TTS_VOICE=
GNANI_TTS_REQUEST_TEMPLATE=       # JSON request; {text} {voice} {lang} placeholders
GNANI_TTS_AUDIO_FIELD=audio       # dotted path to base64 audio, if audio arrives as JSON
GNANI_TTS_EVENT_FIELD=type
GNANI_TTS_END_EVENT=              # value marking the end of an utterance
GNANI_TTS_CANCEL_MESSAGE=         # optional, sent on barge-in
GNANI_TTS_SAMPLE_RATE=16000       # PCM16 mono sample rate of returned audio
TTS_SCRIPT=native                 # native (Devanagari/Bengali) or latin: script of spoken + on-screen agent replies

# 32-byte AES-256-GCM key for transcripts, as 64 hex chars. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TRANSCRIPT_KEY=

# 1 = run fully offline with mocked STT/TTS
MOCK_VOICE=1
PORT=3000
LEDGER_DB=./khata.db
