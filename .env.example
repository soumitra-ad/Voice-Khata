# 32-byte AES-256-GCM key for transcripts, as 64 hex chars. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TRANSCRIPT_KEY=

# 1 = run fully offline with mocked STT/TTS
MOCK_VOICE=1
PORT=3000
LEDGER_DB=./khata.db
