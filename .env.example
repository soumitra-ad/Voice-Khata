# Server-side only. Never copy into public/ or any client file.
# THIS FILE IS COMMITTED TO GIT: never put your real key here. Copy it to .env (gitignored) and fill that.
# GNANI_* values below follow docs.gnani.ai (Quick Start, STT Realtime, TTS Realtime), checked 2026-11-13.
# TODO: VERIFY FROM GNANI DOCS against the live API: `npm run probe -- ./sample.wav --lang hi` and `npm run probe -- --tts "नमस्ते"`.
GNANI_API_KEY=                    # put your key in .env, NOT here
GNANI_AUTH_HEADER=x-api-key-id    # header NAME that carries the key (STT and TTS)
GNANI_AUTH_VALUE={key}            # header value template; {key} = GNANI_API_KEY
GNANI_LANG_MAP=hi:hi-IN,mr:mr-IN,bn:bn-IN,en:en-IN

# Prisma v3.0 STT (WebSocket streaming). Settings are connection headers; {lang} = Gnani language code.
GNANI_STT_WS_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_STT_HEADERS='{"model":"prisma-v3.0","language_code":"{lang}","x-sample-rate":"16000","x-min-silence-ms":"2000","x-idle-timeout-sec":"900"}'
GNANI_STT_FRAME_BYTES=1024        # exact binary frame size (512 samples x 2 bytes)
GNANI_STT_FRAME_MS=32             # real-time cadence at 16 kHz
GNANI_STT_START_MESSAGE=          # none documented
GNANI_STT_END_MESSAGE={"type":"commit"}
GNANI_STT_EVENT_FIELD=type
GNANI_STT_PARTIAL_EVENT=          # streaming sends no partials
GNANI_STT_FINAL_EVENT=transcript
GNANI_STT_SPEECH_EVENT=speech_start
GNANI_STT_ERROR_EVENT=error
GNANI_STT_TEXT_FIELD=text
GNANI_STT_FINAL_TIMEOUT_MS=2500   # longest wait for the last transcript after commit

# Timbre v3.0 TTS (WebSocket streaming). Stock voices only.
GNANI_TTS_WS_URL=wss://api.vachana.ai/api/v1/tts
GNANI_TTS_VOICE=Shivani           # a Timbre v3.0 voice (others: Avinash, Lakshmi)
GNANI_TTS_REQUEST_TEMPLATE='{"text":"{text}","voice":"{voice}","model":"timbre-v3.0","language":"{lang}","audio_config":{"sample_rate":16000,"num_channels":1,"sample_width":2,"encoding":"linear_pcm","container":"raw"}}'
GNANI_TTS_AUDIO_FIELD=data.audio
GNANI_TTS_EVENT_FIELD=type
GNANI_TTS_END_EVENT=complete
GNANI_TTS_ERROR_EVENT=error
GNANI_TTS_REQUEST_ID_FIELD=request_id
GNANI_TTS_CANCEL_MESSAGE=         # none documented: barge-in closes the TTS socket instead
GNANI_TTS_SAMPLE_RATE=16000       # must match audio_config.sample_rate above
TTS_SCRIPT=native                 # native (Devanagari/Bengali) or latin: script of spoken + on-screen agent replies

# 32-byte AES-256-GCM key for transcripts, as 64 hex chars. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TRANSCRIPT_KEY=

# 1 = run fully offline with mocked STT/TTS; 0 = real Gnani
MOCK_VOICE=1
PORT=3000
LEDGER_DB=./khata.db
